// https://mozilla.org/MPL/2.0/

//@version=6
indicator("eVRP – Equity Volatility Risk Premium", shorttitle="eVRP", overlay=false, precision=2)

// ─── Inputs ─────────────────────────────────────────────────────────────────
rvWindow     = input.int(5,   "Realized Vol Window (days)",   minval=2, maxval=60, group="eVRP")
maWindow     = input.int(30,  "VIX Moving Average (days)",    minval=5, maxval=200, group="Filters")
useMAFilter  = input.bool(true, "Require VIX > VIX MA",       group="Filters")
spxSymbol    = input.symbol("SP:SPX",    "S&P 500 Symbol",    group="Data")
vixSymbol    = input.symbol("CBOE:VIX",  "VIX Symbol",        group="Data")
vix3mSymbol  = input.symbol("CBOE:VIX3M","VIX3M Symbol",      group="Data")
showBenchmark = input.bool(true, "Show VIX>VIX3M benchmark",  group="Display")
showTable    = input.bool(true, "Show Info Table",             group="Display")

// ─── Data ───────────────────────────────────────────────────────────────────
vixClose  = request.security(vixSymbol,  timeframe.period, close)
vix3mClose = request.security(vix3mSymbol, timeframe.period, close)
spxClose  = request.security(spxSymbol,  timeframe.period, close)

// ─── Realized Volatility ────────────────────────────────────────────────────
// Annualized realized vol in percentage points (same as the Quantpedia article)
spxRet     = math.log(spxClose / spxClose[1])
realizedVol = ta.stdev(spxRet, rvWindow) * math.sqrt(252) * 100

// ─── eVRP ───────────────────────────────────────────────────────────────────
evrp = vixClose - realizedVol

// ─── VIX Moving Average Filter ──────────────────────────────────────────────
vixMA = ta.sma(vixClose, maWindow)

// ─── Signals ────────────────────────────────────────────────────────────────
evrpSignal    = evrp <= 0
maSignal      = vixClose > vixMA
hedgeSignal   = useMAFilter ? (evrpSignal and maSignal) : evrpSignal
benchmarkSig  = vixClose > vix3mClose

// ─── Plots ──────────────────────────────────────────────────────────────────
// eVRP line
evrpColor = evrp > 0 ? color.new(color.green, 20) : color.new(color.red, 20)
plot(evrp, "eVRP", color=evrpColor, linewidth=2)

// Zero line
hline(0, "Zero", color=color.new(color.gray, 50), linestyle=hline.style_dashed)

// VIX - VIX3M spread (secondary reference)
vixSpread = vixClose - vix3mClose
plot(showBenchmark ? vixSpread : na, "VIX − VIX3M", color=color.new(color.orange, 60), linewidth=1, style=plot.style_line)

// ─── Background ─────────────────────────────────────────────────────────────
// Highlight when hedge signal is active (eVRP ≤ 0, optionally + VIX > MA)
bgcolor(hedgeSignal ? color.new(color.red, 88) : na, title="Hedge Active")

// ─── Bar Coloring (optional visual on the eVRP plot) ────────────────────────
barcolor(hedgeSignal ? color.new(color.orange, 0) : na, title="Hedge Bar Color")

// ─── Alert Conditions ───────────────────────────────────────────────────────
alertcondition(hedgeSignal and not hedgeSignal[1],
     title="Hedge ON",
     message="eVRP hedge signal activated: eVRP={0}, VIX={1}")
alertcondition(not hedgeSignal and hedgeSignal[1],
     title="Hedge OFF",
     message="eVRP hedge signal deactivated: eVRP={0}, VIX={1}")

// ─── Info Table ─────────────────────────────────────────────────────────────
if showTable and barstate.islast
    var table t = table.new(position.top_right, 2, 7,
         bgcolor=color.new(color.black, 20), border_width=1,
         border_color=color.new(color.gray, 60))

    table.cell(t, 0, 0, "VIX",         text_color=color.gray,   text_size=size.small)
    table.cell(t, 1, 0, str.tostring(vixClose, "#.##"),
         text_color=color.white, text_size=size.small)

    table.cell(t, 0, 1, "VIX3M",       text_color=color.gray,   text_size=size.small)
    table.cell(t, 1, 1, str.tostring(vix3mClose, "#.##"),
         text_color=color.white, text_size=size.small)

    table.cell(t, 0, 2, "RVol " + str.tostring(rvWindow) + "D",
         text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(realizedVol, "#.##"),
         text_color=color.white, text_size=size.small)

    table.cell(t, 0, 3, "eVRP",        text_color=color.gray,   text_size=size.small)
    table.cell(t, 1, 3, str.tostring(evrp, "#.##"),
         text_color=evrp > 0 ? color.green : color.red, text_size=size.small)

    table.cell(t, 0, 4, "VIX MA" + str.tostring(maWindow),
         text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 4, str.tostring(vixMA, "#.##"),
         text_color=color.white, text_size=size.small)

    table.cell(t, 0, 5, "VIX>VIX3M",   text_color=color.gray,   text_size=size.small)
    table.cell(t, 1, 5, benchmarkSig ? "YES" : "NO",
         text_color=benchmarkSig ? color.green : color.red, text_size=size.small)

    hedgeLabel = hedgeSignal ? "HEDGE ON" : "HEDGE OFF"
    table.cell(t, 0, 6, "SIGNAL",      text_color=color.gray,   text_size=size.small)
    table.cell(t, 1, 6, hedgeLabel,
         text_color=hedgeSignal ? color.orange : color.gray, text_size=size.small)
